{
  "manifest_version": 3,
  "name": "Dropshot",
  "description": "Captures the whole page you're looking at and uploads it to Dropshot.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Capture full page to Dropshot", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "offscreen"],
  "host_permissions": ["https://d.ghijk.nz/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Capture full page to Dropshot" }
  }
}
