{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dropshot",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "d.ghijk.nz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dropshot" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropshot",
      "database_id": "21f9c5fa-f3e5-4f59-8e8d-912e0891c0bb",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    // Cloudflare Access team domain and application audience tag, from Zero Trust › Access › Applications.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Must match the key prefix set in the Mac app, if any.
    "KEY_PREFIX": ""
  },
  "observability": { "enabled": true }
}
